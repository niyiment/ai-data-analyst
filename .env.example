# Local development environment variables (copy to .env, never commit .env)

# PostgreSQL (Docker Compose)
POSTGRES_DB=ai_data_analyst
POSTGRES_USER=app_owner
POSTGRES_PASSWORD=local_owner_password

# API database URLs (role-separated per docs/DATABASE.md)
DATABASE_URL_APP=postgresql+psycopg://app_rw:local_app_rw_password@localhost:5433/ai_data_analyst
DATABASE_URL_ANALYST=postgresql+psycopg://analyst_ro:local_analyst_ro_password@localhost:5433/ai_data_analyst
# Migrations only — never set on the running API in production
DATABASE_URL_OWNER=postgresql+psycopg://app_owner:local_owner_password@localhost:5433/ai_data_analyst

# LLM (choose "ollama", "ollama_cloud", "gemini", or "claude")
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_CLOUD_BASE_URL=https://ollama.com
OLLAMA_CLOUD_API_KEY=
OLLAMA_CLOUD_MODEL=llama3.2
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-latest

# Security & limits
SESSION_TTL_HOURS=24
CLEANUP_SECRET=local-cleanup-secret
ALLOWED_ORIGIN=http://localhost:3000
RATE_LIMIT_PER_MINUTE=30
QUESTIONS_PER_SESSION_PER_HOUR=30
LLM_DAILY_CALL_BUDGET=1000
MAX_UPLOAD_MB=10
MAX_ROWS=500
QUERY_TIMEOUT_SECONDS=10
LOG_LEVEL=INFO

# Web (server-side only, used for /api/* rewrite)
API_BASE_URL=http://localhost:8000
